<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_task_convert_to_subtask_parent_path_view" model="ir.ui.view">
        <field name="name">project.task.convert.to.subtask.parent.path</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.project_task_convert_to_subtask_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="context">
                    {
                        'search_default_project_id': project_id,
                        'search_default_open_tasks': 1,
                        'default_is_template': is_template,
                        'show_project_task_path': True
                    }
                </attribute>
            </xpath>
        </field>
    </record>
</odoo>
